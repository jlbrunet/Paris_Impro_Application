<div class="container background-absence-admin pb-100px">
  <%= render partial:'/shared/navbar', locals: {title: ""} %>
  <div class="courses-index">
    <h2 class="font-headers">Absences</h2>
    <h2 class="font-headers"><%= @course.day %> | <%= @course.level %></h2>
  </div>
  <div class="border-tableau"></div>

  <details class="past-lessons">
    <summary class="past-lessons-summary">
      <span>Avant aujourd'hui</span>
      <i class="fa-solid fa-chevron-down past-lessons-chevron"></i>
    </summary>
    <div class="past-lessons-body">
      <% if @past_lessons.empty? %>
        <p class="past-lessons-empty">Aucun cours avant aujourd'hui</p>
      <% else %>
        <% @past_lessons.each do |lesson| %>
          <%= render "lesson", lesson: lesson, show_open_place: false %>
        <% end %>
      <% end %>
    </div>
  </details>

  <% @lessons.each do |lesson| %>
    <%= render "lesson", lesson: lesson %>
  <% end %>

  <%= link_to courses_path , class: "btn-red-back btn-left" do %>
    <div><i class="fa-solid fa-circle-chevron-left"></i> Retour</div>
  <% end %>
</div>
